# 475_FTC / MPE Code Style
# Exemplar: v15S/src/core/exemplar_formatting.h (tracked style reference).
# Space-before-paren everywhere, packed single-line functions, stacked
# multi-line if/else (never bunched), zero blank lines, spaced subscripts
# name [i][j] (via tools, C-aware: strings/comments untouched).
# Manual conventions (not machine-enforced): descriptive
# loop/param names (row_index, not i), // for short notes. Known delta
# vs the exemplar (deliberate): top-level definitions stay one-per-line
# (the exemplar packs `} f(){}`).
Language: Cpp
BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
IndentCaseLabels: false
IndentPPDirectives: None
NamespaceIndentation: None

# Braces - attach style (opening brace on same line)
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

# Line width - generous, existing code has long lines
ColumnLimit: 120

# Alignment
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignOperands: true
AlignTrailingComments: false

# Spacing - exemplar: space before every paren
SpaceAfterCStyleCast: true
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: Always
SpaceInEmptyParentheses: false
SpacesInAngles: false
SpacesInCStyleCastParentheses: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpacesInContainerLiterals: false

# Line breaks - exemplar: packed single-line functions; if/else bodies
# ALWAYS stacked multi-line (never bunched), loops expanded.
AllowShortBlocksOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AlwaysBreakAfterReturnType: None
BinPackArguments: true
BinPackParameters: true

# Pointers and references
PointerAlignment: Right
DerivePointerAlignment: false

# Comments
ReflowComments: false
SortIncludes: false

# Misc
Standard: c++11
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false

# ============================================================
# MPE root .gitignore
# Repo root contains: v15R3/  fixes/ (retired)  tools/  run_all.sh  verify.sh
# ============================================================

# ============ Build output (matches anywhere in tree) ============
*.o
*.d
*.obj
*.a
*.so
*.exe
engine
mpe-tui
mpe-tui.d
test_*
build/
.fixes_generation_1/
# DESPOT-FIX: was `reference_materials/` — that ignored the 12-file 19MB
# collision/solver/textbook reference library (Coumans/Gottschalk/Mirtich/
# Baraff/Catto/Teschner), risking untracked loss of the audit's own sources.
# Build outputs are already covered by *.o/*.so/build/ above; references stay
# tracked.

# ============ Fix-script backups ============
# Every fix script creates .pre_NNN backups before mutating
*.pre_*

# ============ Backup / scratch files ============
*.bak
*.bak_*
*.orig
*.rej
*~

# ============ Editor swap files ============
*.swp
*.swo
.*.swp

# ============ Editors / IDEs ============
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
compile_commands.json
.cache/

# ============ OS cruft ============
.DS_Store
Thumbs.db
desktop.ini

# ============ Runtime state (engine writes at startup) ============
# status/ dirs contain engine.cfg, scene.dat — regenerated
status/

# ============ Logs ============
# fix_log.txt IS tracked (execution history). Only stray logs ignored.
!v15R3/v03_gate_validation.log
*.log

# ============ Sanitizer / temp build artifacts ============
/tmp/
*.san

# Keep the Python test harness itself versioned despite the broad C artifact
# pattern above; discard only interpreter cache files.
!tools/tests/*.py
__pycache__/
*.py[cod]
